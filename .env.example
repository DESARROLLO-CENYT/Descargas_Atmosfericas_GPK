# Copiar a .env (ya esta en .gitignore).

# De donde lee los datos el tablero:
#   parquet  (por defecto) el parquet del repositorio. Nunca se conecta a
#            Supabase, aunque la URL de abajo este definida: no gasta egress.
#   supabase la base de produccion. Requiere SUPABASE_DASHBOARD_DB_URL.
FUENTE_DATOS=parquet

# Solo para FUENTE_DATOS=supabase: usuario de solo lectura "dashboard_readonly"
# por el Transaction pooler (puerto 6543) de Supabase.
SUPABASE_DASHBOARD_DB_URL=postgresql://dashboard_readonly.REF_DEL_PROYECTO:TU_PASSWORD@aws-0-us-east-2.pooler.supabase.com:6543/postgres

# Gold consolidado que genera el pipeline; lo usa scripts/actualizar_parquet.py
# para refrescar el parquet de pruebas sin tocar Supabase.
RUTA_GOLD_PIPELINE=C:\ruta\al\pipeline\Data\3. Gold\Gold_Consolidado_Historico_Descargas_Electricas_GPK.parquet
